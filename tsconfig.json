{
    "compilerOptions": {
        "paths": {
            "@shared/*": ["./src/shared/*"]
        },
        "rootDir": "./src",
        "outDir": "./dist/",
        "noEmit": true,
        "strict": false,
        "module": "ESNext",
        "target": "ES2020",
        "lib": ["ES2020"],
        "types": ["node"],
        "moduleResolution": "bundler",
        "experimentalDecorators": true,
        "emitDecoratorMetadata": true,
        "useDefineForClassFields": false,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "skipLibCheck": true
    },
    "include": ["./src/**/*"],
    "exclude": ["node_modules", "dist", "test"]
}
